local function buildTabGlyph(parent, glyphId, initialColor)
	local box = Instance.new("Frame")
	box.Name = randName(6)
	box.Size = UDim2.fromOffset(18, 18)
	box.Position = UDim2.fromOffset(12, 9)
	box.BackgroundTransparency = 1
