local function registerNoDragControls(root)
	local function attach(obj)
		if obj:IsA("GuiButton") or obj:IsA("TextBox") then
			if obj ~= bottomPillBtn and obj ~= cornerGripBtn then
				Client.Bind(obj.InputBegan, function(inp)
					if inp.UserInputType == Enum.UserInputType.MouseButton1 then
						suppressDragUntil = os.clock() + 0.25
					end
				end)
			end
		end
	end
	for _, d in ipairs(root:GetDescendants()) do attach(d) end
	Client.Bind(root.DescendantAdded, attach)
end

