	local valLbl = Instance.new("TextLabel")
	valLbl.Size = UDim2.new(0.35, -2, 0, 16)
	valLbl.Position = UDim2.new(0.65, 0, 0, 0)
	valLbl.BackgroundTransparency = 1
	applyMonoFont(valLbl, 11)
	valLbl.Text = tostring(Client.State[stateKey]) .. (suffix or "")
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.ZIndex = 22
	valLbl.Parent = wrap

	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, -4, 0, 16)
	hit.Position = UDim2.fromOffset(2, 18)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.ZIndex = 24
	hit.Parent = wrap

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 3)
	bar.Position = UDim2.new(0, 0, 0.5, -1)
	bar.BackgroundColor3 = Color3.fromRGB(36, 30, 54)
	bar.BorderSizePixel = 0
	bar.ZIndex = 22
	bar.Parent = hit
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 99)
	bc.Parent = bar

	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.fromScale(0, 1)
	barFill.BorderSizePixel = 0
	barFill.ZIndex = 23
	barFill.Parent = bar
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0, 99)
	fc.Parent = barFill

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(10, 10)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale(0, 0.5)
	knob.BackgroundColor3 = Color3.fromRGB(246, 240, 255)
	knob.BorderSizePixel = 0
	knob.ZIndex = 24
	knob.Parent = bar
	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(0, 99)
	kc.Parent = knob

	local function refreshVisual()
		local v = math.clamp(Client.State[stateKey] or minVal, minVal, maxVal)
		local frac = (v - minVal) / math.max(1, maxVal - minVal)
		barFill.Size = UDim2.fromScale(frac, 1)
		knob.Position = UDim2.fromScale(frac, 0.5)
		valLbl.Text = tostring(v) .. (suffix or "")
	end

	local sliding = false
	local function setFromX(absX)
		local bx = bar.AbsolutePosition.X
		local bw = math.max(1, bar.AbsoluteSize.X)
		local frac = math.clamp((absX - bx) / bw, 0, 1)
		Client.State[stateKey] = math.floor(minVal + frac * (maxVal - minVal) + 0.5)
		refreshVisual()
	end

	Client.Bind(hit.InputBegan, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			sliding = true
			setFromX(inp.Position.X)
		end
	end)
	Client.Bind(UserInputService.InputChanged, function(inp)
		if sliding and inp.UserInputType == Enum.UserInputType.MouseMovement then
			setFromX(inp.Position.X)
		end
	end)
	Client.Bind(UserInputService.InputEnded, function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			sliding = false
		end
	end)

	refreshVisual()
	table.insert(Client.ThemeListeners, function(th)
		lbl.TextColor3 = th.mid
		valLbl.TextColor3 = th.neon
