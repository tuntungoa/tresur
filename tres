	function Engine.pickPlaceableBlock(desiredName, virtualUsed)
		local data = localPlayer:FindFirstChild("Data")
		local bpFolder = ReplicatedStorage:FindFirstChild("BuildingParts")
		if not data or not bpFolder then return nil, 0 end

		local function avail(name)
			local val = data:FindFirstChild(name)
			local baseCount = val and val.Value or 0
			return baseCount - (virtualUsed[name] or 0), baseCount
		end

		if desiredName and bpFolder:FindFirstChild(desiredName) then
			local rem, baseCount = avail(desiredName)
			if rem > 0 then return desiredName, baseCount end
		end

		local bestName, bestRem, bestBase = nil, 0, 0
		for _, ch in ipairs(data:GetChildren()) do
			if ch:IsA("IntValue") or ch:IsA("NumberValue") then
				local n = ch.Name
				if string.find(n, "Block") and bpFolder:FindFirstChild(n) then
					local rem, baseCount = avail(n)
					if rem > bestRem then
						bestRem = rem
						bestBase = baseCount
						bestName = n
					end
				end
			end
		end
		return bestName, bestBase
	end

	function Engine.placeServerBlocks(items, labelPrefix)
		if Engine.buildBusy then
			Engine.setStatus("стройка уже идет...")
			return
		end
		Engine.buildBusy = true
		task.spawn(function()
			local hum = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
			pcall(function()
				local tool = localPlayer.Backpack:FindFirstChild("BuildingTool")
					or (localPlayer.Character and localPlayer.Character:FindFirstChild("BuildingTool"))
				local zone = Engine.getPlayerZone(localPlayer)
				if not tool or not tool:FindFirstChild("RF") or not zone then
					Engine.setStatus("нет BuildingTool/зоны")
					return
				end
				if hum and tool.Parent == localPlayer.Backpack then
					hum:EquipTool(tool)
					task.wait(0.22)
				end

				local virtualUsed = {}
				local placed = 0
				local total = #items
				local rf = tool.RF

				for i, entry in ipairs(items) do
					if not Client.Alive or not Engine.buildBusy then break end
					if Engine.isCFrameInZone(entry.worldCF.Position, zone) then
						local useName, ownedCount = Engine.pickPlaceableBlock(entry.name, virtualUsed)
						if not useName then
							Engine.setStatus(string.format("кончились блоки (%d/%d)", placed, total))
							break
						end
						virtualUsed[useName] = (virtualUsed[useName] or 0) + 1
						local relCF = zone.CFrame:ToObjectSpace(entry.worldCF)
						task.spawn(function()
							pcall(function()
								rf:InvokeServer(useName, ownedCount, zone, relCF, true, entry.worldCF, false, true)
							end)
						end)
						placed = placed + 1
						if (i % 5 == 0) or i == total then
							Engine.setStatus(string.format("%s: %d/%d", labelPrefix, placed, total))
						end
						task.wait(0.065)
					end
				end
				task.wait(0.25)
				if hum then pcall(function() hum:UnequipTools() end) end
				Engine.setStatus(string.format("%s готово: %d", labelPrefix, placed))
			end)
			if hum then pcall(function() hum:UnequipTools() end) end
			Engine.buildBusy = false
		end)
	end

