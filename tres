	function Engine.buildPresetBlueprint()
		local zone = Engine.getPlayerZone(localPlayer)
		if not zone then Engine.setStatus("зона не найдена") return end
		local baseCF = zone.CFrame * CFrame.new(0, zone.Size.Y * 0.5 + 1.0, 0)
		local items = {}
		local preset = Client.State.buildPreset

		if preset == "Heart" then
			local pts = {
				{-2,3}, {-1,4}, {1,4}, {2,3},
				{-3,2}, {0,3}, {3,2},
				{-3,1}, {3,1}, {-2,0}, {2,0},
				{-1,-1}, {1,-1}, {0,-2},
			}
			for _, p in ipairs(pts) do
				table.insert(items, {
					name = "NeonBlock",
					worldCF = baseCF * CFrame.new(p[1] * 2, (p[2] + 2) * 2, 0),
				})
			end
		elseif preset == "Tower" then
			for y = 0, 7 do
				local ring = (y % 2 == 0) and {{-1,0},{1,0},{0,-1},{0,1}} or {{0,0}}
				for _, r in ipairs(ring) do
					table.insert(items, {
						name = "WoodBlock",
						worldCF = baseCF * CFrame.new(r[1] * 2, y * 2, r[2] * 2),
					})
				end
			end
		else
			-- FarmRaft: compact 3x3 raft + central column
			for gx = -1, 1 do
				for gz = -1, 1 do
					table.insert(items, {
						name = "WoodBlock",
						worldCF = baseCF * CFrame.new(gx * 2, 0, gz * 2),
					})
				end
			end
		end

		Engine.placeServerBlocks(items, preset)
	end

	function Engine.clearMyPlot()
