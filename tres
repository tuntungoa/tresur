local function beginInteraction(mode, input)
	activeDragMode = mode
	dragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
	dragStartX, dragStartY = targetX, targetY
	dragStartW, dragStartH = targetW, targetH
end

Client.Bind(bottomPillBtn.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		bottomPillVisual.BackgroundColor3 = getTheme().neon
		bottomPillVisual.Size = UDim2.fromOffset(58, 2)
		beginInteraction("resizeH", input)
	end
end)
Client.Bind(bottomPillBtn.MouseEnter, function()
	if not activeDragMode then
		Client.TrackTween(TweenService:Create(bottomPillVisual, TweenInfo.new(0.16), { Size = UDim2.fromOffset(56, 2) }))
	end
end)
Client.Bind(bottomPillBtn.MouseLeave, function()
	if not activeDragMode then
		Client.TrackTween(TweenService:Create(bottomPillVisual, TweenInfo.new(0.16), { Size = UDim2.fromOffset(42, 2) }))
	end
end)

Client.Bind(cornerGripBtn.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then beginInteraction("resizeCorner", input) end
end)

Client.Bind(glassWindow.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if os.clock() < suppressDragUntil then return end
		local my = input.Position.Y
		local winBottom = glassWindow.AbsolutePosition.Y + glassWindow.AbsoluteSize.Y
		if my <= winBottom - 36 then beginInteraction("move", input) end
	end
end)

Client.Bind(UserInputService.InputChanged, function(input)
	if not activeDragMode then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
	local delta = Vector2.new(input.Position.X - dragStartMouse.X, input.Position.Y - dragStartMouse.Y)
	if activeDragMode == "move" then
		targetX = dragStartX + delta.X
		targetY = dragStartY + delta.Y
		clampWindowTarget()
	elseif activeDragMode == "resizeH" then
		targetH = dragStartH + delta.Y
		clampWindowTarget()
	elseif activeDragMode == "resizeCorner" then
		targetW = dragStartW + delta.X
		targetH = dragStartH + delta.Y
		clampWindowTarget()
	end
end)

Client.Bind(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and activeDragMode then
		activeDragMode = nil
		bottomPillVisual.BackgroundColor3 = getTheme().bright
		Client.TrackTween(TweenService:Create(bottomPillVisual, TweenInfo.new(0.18), { Size = UDim2.fromOffset(42, 2) }))
		commitWindowGeometry()
	end
end)

