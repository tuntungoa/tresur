local vpInit = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1009)

local function sanitizeConfigName(raw)
	if type(raw) ~= "string" then return "" end
	local clean = raw:gsub("[^A-Za-z0-9_%-]", "")
	if #clean > 24 then clean = string.sub(clean, 1, 24) end
	return clean
end

