-- 14. SMOOTH DRAG & RESIZE PHYSICS (ZERO CLICK JUMP)
-- ============================================================================
local MIN_W, MAX_W = 520, 1650
local MIN_H, MAX_H = 340, 960

local curX, curY = Client.State.posX, Client.State.posY
local curW, curH = Client.State.width, Client.State.height
local targetX, targetY = curX, curY
local targetW, targetH = curW, curH

function Client.SyncWindowFromState()
	targetW = Client.State.width
	targetH = Client.State.height
	targetX = Client.State.posX
	targetY = Client.State.posY
	sizeReadout.Text = string.format("%d × %d", math.floor(targetW + 0.5), math.floor(targetH + 0.5))
end

local function clampWindowTarget()
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
	local maxWAllowed = math.min(MAX_W, math.floor(vp.X - 40))
	local maxHAllowed = math.min(MAX_H, math.floor(vp.Y - 40))
	targetW = math.clamp(targetW, MIN_W, math.max(MIN_W, maxWAllowed))
	targetH = math.clamp(targetH, MIN_H, math.max(MIN_H, maxHAllowed))
	targetX = math.clamp(targetX, -targetW + 140, vp.X - 140)
	targetY = math.clamp(targetY, 10, vp.Y - 80)
	sizeReadout.Text = string.format("%d × %d", math.floor(targetW + 0.5), math.floor(targetH + 0.5))
end

local function commitWindowGeometry()
	Client.State.width = math.floor(targetW + 0.5)
	Client.State.height = math.floor(targetH + 0.5)
	Client.State.posX = math.floor(targetX + 0.5)
	Client.State.posY = math.floor(targetY + 0.5)
	Client.SaveConfig(Client.ActiveConfigName)
end

local function stepWindowSize(dw, dh)
	local oldW, oldH = targetW, targetH
	targetW = math.clamp(oldW + dw, MIN_W, MAX_W)
	targetH = math.clamp(oldH + dh, MIN_H, MAX_H)
	targetX = targetX - (targetW - oldW) * 0.5
	targetY = targetY - (targetH - oldH) * 0.5
	clampWindowTarget()
	commitWindowGeometry()
end

