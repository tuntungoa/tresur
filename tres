	local cs = Instance.new("UIStroke")
	cs.Thickness = 1
	cs.Transparency = 0.45
	cs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	cs.Parent = cycBtn

	local function refreshText()
		local cur = Client.State[stateKey]
		local label = tostring(cur)
		for _, opt in ipairs(options) do
			if opt.value == cur then label = opt.label break end
		end
		cycBtn.Text = label
	end

	Client.Bind(cycBtn.MouseButton1Click, function()
		local cur = Client.State[stateKey]
		local nextIdx = 1
		for i, opt in ipairs(options) do
			if opt.value == cur then
				nextIdx = (i % #options) + 1
				break
			end
		end
		Client.State[stateKey] = options[nextIdx].value
		refreshText()
	end)

	refreshText()
	table.insert(Client.ThemeListeners, function(th)
		lbl.TextColor3 = th.bright
		cycBtn.BackgroundColor3 = th.tabActiveBg
		cycBtn.BackgroundTransparency = 0.28
		cycBtn.TextColor3 = th.bright
		cs.Color = th.neon
	end)
	table.insert(Client.StateListeners, refreshText)
end

