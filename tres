		local guard = Instance.new("Frame")
		guard.Size = UDim2.fromOffset(7, 2)
		guard.Position = UDim2.fromOffset(5, 11)
		guard.AnchorPoint = Vector2.new(0.5, 0.5)
		guard.Rotation = 45
		guard.BorderSizePixel = 0
		guard.ZIndex = 22
		guard.Parent = box
		local gc = Instance.new("UICorner")
