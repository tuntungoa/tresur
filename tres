				if Engine.savedWater[wsWater] == nil then
					Engine.savedWater[wsWater] = { touch = wsWater.CanTouch, col = wsWater.CanCollide }
				end
				wsWater.CanTouch = false
				wsWater.CanCollide = true
			elseif Engine.savedWater[wsWater] then
				wsWater.CanTouch = Engine.savedWater[wsWater].touch
				wsWater.CanCollide = Engine.savedWater[wsWater].col
				Engine.savedWater[wsWater] = nil
			end
		end
		local ns = Engine.getNormalStages()
		if ns then
			for _, d in ipairs(ns:GetDescendants()) do
				if d:IsA("BasePart") and d.Name == "Water" then
					if on then
						if Engine.savedWater[d] == nil then
							Engine.savedWater[d] = { touch = d.CanTouch, col = d.CanCollide }
						end
						d.CanTouch = false
						d.CanCollide = true
