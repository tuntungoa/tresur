		for i = 1, 3 do
			local ln = Instance.new("Frame")
			ln.Size = UDim2.fromOffset(lineWidths[i], 1)
			ln.Position = UDim2.fromOffset(2, lineYs[i])
			ln.BorderSizePixel = 0
			ln.ZIndex = 23
			ln.Parent = sheet
			table.insert(parts, ln)
		end
	elseif glyphId == "main" then
		local blade = Instance.new("Frame")
		blade.Size = UDim2.fromOffset(2, 13)
		blade.Position = UDim2.fromOffset(9, 2)
		blade.AnchorPoint = Vector2.new(0.5, 0)
