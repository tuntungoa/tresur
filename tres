local function makeMiniSwitch(parent, pos, initialVal, onToggle)
	local isOn = initialVal == true
	local sw = Instance.new("TextButton")
	sw.Name = randName(6)
	sw.Size = UDim2.fromOffset(38, 20)
	sw.Position = pos
	sw.BorderSizePixel = 0
	sw.AutoButtonColor = false
	sw.Text = ""
	sw.ZIndex = 24
	sw.Parent = parent

	local sc = Instance.new("UICorner")
	sc.CornerRadius = UDim.new(0, 99)
	sc.Parent = sw

	local ss = Instance.new("UIStroke")
	ss.Thickness = 1
	ss.Transparency = 0.52
	ss.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ss.Parent = sw

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(14, 14)
	knob.BackgroundColor3 = Color3.fromRGB(246, 240, 255)
	knob.BorderSizePixel = 0
	knob.ZIndex = 25
	knob.Parent = sw
	local kc = Instance.new("UICorner")
	kc.CornerRadius = UDim.new(0, 99)
	kc.Parent = knob

	local function paint(animate)
		local th = getTheme()
		local bg = isOn and th.accent or Color3.fromRGB(40, 34, 58)
		local p = isOn and UDim2.fromOffset(21, 3) or UDim2.fromOffset(3, 3)
		ss.Color = isOn and th.bright or th.muted
		if animate then
			Client.TrackTween(TweenService:Create(sw, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = bg }))
			Client.TrackTween(TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = p }))
		else
			sw.BackgroundColor3 = bg
			knob.Position = p
		end
	end

	paint(false)
	table.insert(Client.ThemeListeners, function() paint(false) end)

	Client.Bind(sw.MouseButton1Click, function()
		isOn = not isOn
		paint(true)
		if onToggle then onToggle(isOn) end
	end)

	return sw, function(val)
		isOn = val == true
		paint(true)
	end
end

