				end
				local list = myBlocks:GetChildren()
				if #list == 0 then
					Engine.setStatus("база уже пустая")
					return
				end
				if hum and del.Parent == localPlayer.Backpack then
					hum:EquipTool(del)
					task.wait(0.2)
				end
				local drf = del.RF
				for i, blk in ipairs(list) do
					if not Client.Alive then break end
					task.spawn(function() pcall(function() drf:InvokeServer(blk) end) end)
					if i % 6 == 0 then task.wait(0.05) end
				end
				task.wait(0.3)
				if hum then pcall(function() hum:UnequipTools() end) end
				Engine.setStatus("очищено блоков: " .. tostring(#list))
			end)
			Engine.buildBusy = false
		end)
	end

	-- ---- ESP & CLEANUP ----
	function Engine.clearEspForPlayer(plr)
		local ent = Engine.espEntries[plr]
		if ent then
			ent.boxOutline.Visible = false
			ent.boxMain.Visible = false
			ent.nameTxt.Visible = false
		end
		local hl = Client.Janitor.highlights[plr]
		if hl then hl.Enabled = false end
	end

	function Engine.removeEspForPlayer(plr)
		local ent = Engine.espEntries[plr]
		if ent then
			for _, d in pairs(ent) do pcall(function() d.Visible = false; d:Remove() end) end
			Engine.espEntries[plr] = nil
		end
		local hl = Client.Janitor.highlights[plr]
		if hl then pcall(function() hl:Destroy() end) Client.Janitor.highlights[plr] = nil end
	end

	function Engine.getOrCreateEsp(plr)
		if Engine.espEntries[plr] then return Engine.espEntries[plr] end
		if not Engine.hasDrawing then return nil end
		local ent = {
			boxOutline = Client.TrackDrawing(Drawing.new("Square")),
			boxMain = Client.TrackDrawing(Drawing.new("Square")),
			nameTxt = Client.TrackDrawing(Drawing.new("Text")),
		}
		ent.boxOutline.Filled = false
		ent.boxOutline.Thickness = 2.5
		ent.boxOutline.Color = Color3.new(0, 0, 0)
		ent.boxOutline.Transparency = 0.72
		ent.boxMain.Filled = false
		ent.boxMain.Thickness = 1.2
		ent.boxMain.Transparency = 0.95
		ent.nameTxt.Size = 12
		ent.nameTxt.Center = true
		ent.nameTxt.Outline = true
		ent.nameTxt.OutlineColor = Color3.new(0, 0, 0)
		Engine.espEntries[plr] = ent
		Engine.clearEspForPlayer(plr)
		return ent
	end

	restoreAllBabft = function()
		Engine.buildBusy = false
		Engine.stopFly()
		Engine.stopBoatFly()
		Engine.stopFarmStabilizer()
		Engine.restoreNoclip()
		Engine.applyWalkOnWater(false)
		Engine.applyWaterProtection(false)
		Engine.clearHologram()
		Engine.applyAntiDarkness(false)
		Engine.applyFullbright(false)
	end

	table.insert(Client.StateListeners, function()
		if not Client.Alive then return end
		Engine.applyWalkOnWater(Client.State.walkOnWater)
		Engine.applyAntiDarkness(Client.State.antiDarkness)
		Engine.applyFullbright(Client.State.fullbright)
		if Client.State.hologramPreview and not Engine.hologramFolder then
			Engine.updateHologram(true)
		elseif not Client.State.hologramPreview and Engine.hologramFolder then
