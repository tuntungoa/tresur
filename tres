local activeTabId = "main"

local function refreshTabsVisual()
	local th = getTheme()
	for id, btnData in pairs(tabButtons) do
		local isAct = (id == activeTabId)
		tabPages[id].Visible = isAct
		btnData.btn.BackgroundColor3 = isAct and th.tabActiveBg or th.tabIdleBg
		btnData.btn.BackgroundTransparency = isAct and 0.24 or 0.80
		btnData.stroke.Color = isAct and th.neon or th.muted
		btnData.stroke.Transparency = isAct and 0.36 or 0.92
		btnData.indicator.BackgroundColor3 = th.neon
		btnData.indicator.BackgroundTransparency = isAct and 0.05 or 1
		btnData.label.TextColor3 = isAct and th.bright or th.muted
		btnData.setGlyphColor(isAct and th.neon or th.muted, isAct and 0 or 0.12)
	end
end

function Client.SetTab(tabId)
	if tabPages[tabId] then
		activeTabId = tabId
		refreshTabsVisual()
		return true
	end
	return false
end

