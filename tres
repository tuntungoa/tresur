	function Engine.extractBoatLayout(targetName)
		local blocksFolder = workspace:FindFirstChild("Blocks")
		local tFolder = blocksFolder and targetName and blocksFolder:FindFirstChild(targetName)
		local myZone = Engine.getPlayerZone(localPlayer)
		if not tFolder or not myZone then return nil end

		local raw = {}
		local sumPos = Vector3.zero
		local minY = math.huge
		for _, m in ipairs(tFolder:GetChildren()) do
			local pp = m:FindFirstChild("PPart") or (m:IsA("Model") and m.PrimaryPart)
			if pp and pp:IsA("BasePart") then
				table.insert(raw, {
					name = m.Name,
					cf = pp.CFrame,
					size = pp.Size,
					color = pp.Color,
				})
				sumPos = sumPos + pp.Position
				local bottom = pp.Position.Y - pp.Size.Y * 0.5
				if bottom < minY then minY = bottom end
			end
		end
		if #raw == 0 then return nil end

		local targetPlr = Players:FindFirstChild(targetName)
		local oZone = Engine.getPlayerZone(targetPlr)
		local centroid = sumPos / #raw
		local useOtherZone = false
		if oZone then
			local relCentroid = oZone.CFrame:PointToObjectSpace(centroid)
			if math.abs(relCentroid.X) < oZone.Size.X * 0.65 and math.abs(relCentroid.Z) < oZone.Size.Z * 0.65 then
				useOtherZone = true
			end
		end

		local mapped = {}
		local anchorOrigin = CFrame.new(centroid.X, minY, centroid.Z)
		local myBaseTop = myZone.CFrame * CFrame.new(0, myZone.Size.Y * 0.5 + 0.5, 0)
		for _, item in ipairs(raw) do
			local worldCF
			if useOtherZone and oZone then
				worldCF = myZone.CFrame * oZone.CFrame:ToObjectSpace(item.cf)
			else
				worldCF = myBaseTop * anchorOrigin:ToObjectSpace(item.cf)
			end
			table.insert(mapped, {
				name = item.name,
				worldCF = worldCF,
				size = item.size,
				color = item.color,
			})
		end
		return mapped
	end

