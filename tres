	Client.Bind(Players.PlayerRemoving, function(plr)
		Engine.removeEspForPlayer(plr)
	end)

	Client.Bind(localPlayer.Idled, function()
		if Client.Alive and (Client.State.antiAfk or Client.State.autoFarmGold) then
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.zero)
			end)
		end
	end)

	Client.Bind(UserInputService.JumpRequest, function()
		if not Client.Alive or not Client.State.infJump then return end
		local ch = localPlayer.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)

	Client.Bind(UserInputService.InputBegan, function(input, gp)
		if gp or not Client.Alive then return end
		if input.KeyCode == Enum.KeyCode.F then
			Client.State.flyEnabled = not Client.State.flyEnabled
			if not Client.State.flyEnabled then Engine.stopFly() end
			for _, fn in ipairs(Client.StateListeners) do pcall(fn) end
		elseif input.KeyCode == Enum.KeyCode.V then
			Client.State.boatFly = not Client.State.boatFly
			if not Client.State.boatFly then Engine.stopBoatFly() end
			for _, fn in ipairs(Client.StateListeners) do pcall(fn) end
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 and Client.State.clickTp then
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
				local ch = localPlayer.Character
				local root = ch and ch:FindFirstChild("HumanoidRootPart")
				local cam = workspace.CurrentCamera
				if ch and root and cam then
					local mLoc = UserInputService:GetMouseLocation()
					local ray = cam:ViewportPointToRay(mLoc.X, mLoc.Y)
					local rp = RaycastParams.new()
					rp.FilterType = Enum.RaycastFilterType.Exclude
					rp.FilterDescendantsInstances = Engine.hologramFolder and { ch, Engine.hologramFolder } or { ch }
					local res = workspace:Raycast(ray.Origin, ray.Direction * 1500, rp)
					local hitPos = res and res.Position or nil
					if hitPos then
						root.AssemblyLinearVelocity = Vector3.zero
						ch:PivotTo(CFrame.new(hitPos + Vector3.new(0, 3.6, 0)) * (root.CFrame - root.Position))
						local ring = Instance.new("Part")
						ring.Shape = Enum.PartType.Cylinder
						ring.Anchored = true
						ring.CanCollide = false
						ring.CanTouch = false
						ring.CanQuery = false
						ring.Material = Enum.Material.Neon
						ring.Color = (Client.Themes[Client.State.theme] or Client.Themes.Lavender).neon
						ring.Size = Vector3.new(0.25, 2, 2)
						ring.CFrame = CFrame.new(hitPos + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
						ring.Transparency = 0.2
						ring.Parent = workspace
						local tw = TweenService:Create(ring, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Size = Vector3.new(0.1, 10, 10),
							Transparency = 1,
						})
						tw.Completed:Once(function() pcall(function() ring:Destroy() end) end)
						tw:Play()
					end
				end
			end
		end
	end)

	Client.Bind(RunService.Stepped, function()
		if not Client.Alive or not Client.State.autoFarmGold then return end
		local ch = localPlayer.Character
		if ch then
			for _, p in ipairs(ch:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false end
			end
		end
	end)

	Client.Bind(RunService.Heartbeat, function()
		if not Client.Alive then return end
		local ch = localPlayer.Character
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 then return end

		local cam = workspace.CurrentCamera
		local function getMoveVec()
			if not cam then return Vector3.zero end
			local move = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
			return move.Magnitude > 0.01 and move.Unit or Vector3.zero
		end

		-- Boat Fly (when seated on a boat seat!)
		local seat = hum.SeatPart
		if Client.State.boatFly and seat and seat:IsA("BasePart") and not Client.State.autoFarmGold then
			Engine.stopFly()
			if not Engine.boatBV or Engine.boatBV.Parent ~= seat then
				Engine.stopBoatFly()
				local bv = Instance.new("BodyVelocity")
				bv.MaxForce = Vector3.new(9e7, 9e7, 9e7)
				bv.Velocity = Vector3.zero
				bv.Parent = seat
				Engine.boatBV = bv
				local bg = Instance.new("BodyGyro")
				bg.MaxTorque = Vector3.new(9e7, 9e7, 9e7)
				bg.P = 5e4
				bg.CFrame = seat.CFrame
				bg.Parent = seat
				Engine.boatBG = bg
			end
			local dir = getMoveVec()
			Engine.boatBV.Velocity = dir * Client.State.boatFlySpeed
			if cam then
				local look = Vector3.new(cam.CFrame.LookVector.X, cam.CFrame.LookVector.Y, cam.CFrame.LookVector.Z)
				Engine.boatBG.CFrame = CFrame.lookAt(seat.Position, seat.Position + look)
			end
			return
		elseif Engine.boatBV then
			Engine.stopBoatFly()
		end

		-- Regular Character Fly (F)
		if Client.State.flyEnabled and not Client.State.autoFarmGold then
			if not Engine.flyBV or Engine.flyBV.Parent ~= root then
				Engine.stopFly()
				local bv = Instance.new("BodyVelocity")
				bv.MaxForce = Vector3.new(9e4, 9e4, 9e4)
				bv.Velocity = Vector3.zero
				bv.Parent = root
				Engine.flyBV = bv
				local bg = Instance.new("BodyGyro")
				bg.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
				bg.P = 9e4
				bg.CFrame = root.CFrame
				bg.Parent = root
				Engine.flyBG = bg
			end
			hum.PlatformStand = true
			if cam then
				Engine.flyBV.Velocity = getMoveVec() * Client.State.flySpeed
				Engine.flyBG.CFrame = cam.CFrame
			end
		end
	end)
end

