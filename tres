function Client.TrackInstance(inst)
	if inst then
		pcall(function() inst:SetAttribute("KronosClientMarker", true) end)
		table.insert(Client.Janitor.instances, inst)
	end
	return inst
end

function Client.TrackSound(snd)
	if snd then
		pcall(function() snd:SetAttribute("KronosClientMarker", true) end)
		table.insert(Client.Janitor.sounds, snd)
	end
	return snd
end


function Client.TrackDrawing(d)
	if d then
		table.insert(Client.Janitor.drawings, d)
	end
	return d
end

function Client.TrackTween(tw)
	if tw then
		Client.Janitor.activeTweens[tw] = true
		tw.Completed:Once(function()
			Client.Janitor.activeTweens[tw] = nil
			pcall(function() tw:Destroy() end)
		end)
		tw:Play()
	end
	return tw
end

function Client.Bind(sig, fn)
	local conn
	if STATE and STATE.connect then
		conn = STATE.connect(sig, fn)
	else
		conn = sig:Connect(fn)
	end
	table.insert(Client.Janitor.connections, conn)
	return conn
end

local restoreAllBabft = nil

function Client.Unload()
	if not Client.Alive then return end
	Client.Alive = false

	if restoreAllBabft then pcall(restoreAllBabft) end

	for _, d in ipairs(Client.Janitor.drawings) do
		pcall(function()
			d.Visible = false
			d:Remove()
		end)
	end
	table.clear(Client.Janitor.drawings)

	for _, hl in pairs(Client.Janitor.highlights) do
		pcall(function() hl:Destroy() end)
	end
	table.clear(Client.Janitor.highlights)

	for tw, _ in pairs(Client.Janitor.activeTweens) do
		pcall(function()
			tw:Cancel()
			tw:Destroy()
		end)
	end
	table.clear(Client.Janitor.activeTweens)

	for _, conn in ipairs(Client.Janitor.connections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(Client.Janitor.connections)

	for _, snd in ipairs(Client.Janitor.sounds) do
		pcall(function()
			snd:Stop()
			snd:Destroy()
		end)
	end
	table.clear(Client.Janitor.sounds)

	for _, inst in ipairs(Client.Janitor.instances) do
		pcall(function()
			if inst:IsA("BlurEffect") then inst.Enabled = false end
			inst:Destroy()
		end)
	end
	table.clear(Client.Janitor.instances)
	table.clear(Client.ThemeListeners)
	table.clear(Client.StateListeners)

	if _G.KronosClient == Client then
		_G.KronosClient = nil
	end
end

_G.KronosClient = Client
_G.__KRONOS_CLEANUP = Client.Unload
pcall(function()
	local genv = getgenv and getgenv()
	if type(genv) == "table" then
		genv.__KRONOS_CLEANUP = Client.Unload
	end
end)
if STATE and STATE.onCleanup then
	STATE.onCleanup(Client.Unload)
end

