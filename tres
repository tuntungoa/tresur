-- 0. SINGLE-INSTANCE ANTI-DUPLICATE TERMINATOR
-- ============================================================================
local function terminatePreviousInstances()
	local okG, genv = pcall(function() return getgenv and getgenv() end)
	if okG and type(genv) == "table" and type(genv.__KRONOS_CLEANUP) == "function" then
		pcall(genv.__KRONOS_CLEANUP)
		genv.__KRONOS_CLEANUP = nil
	end
	if type(_G.__KRONOS_CLEANUP) == "function" then
		pcall(_G.__KRONOS_CLEANUP)
		_G.__KRONOS_CLEANUP = nil
	end


	local function purgeTagged(container)
		if not container then return end
		local okList, children = pcall(function() return container:GetChildren() end)
		if not okList then return end
		for _, child in ipairs(children) do
			local isKronos = false
			pcall(function()
				if child:GetAttribute("KronosClientMarker") == true then
					isKronos = true
				end
			end)
			if isKronos then
				pcall(function()
					if child:IsA("Sound") then child:Stop() end
					if child:IsA("BlurEffect") then child.Enabled = false end
					child:Destroy()
				end)
			end
		end
	end
	purgeTagged(gethui())
	pcall(function() purgeTagged(game:GetService("CoreGui")) end)
	purgeTagged(Lighting)
	purgeTagged(SoundService)
end

terminatePreviousInstances()

local function randName(len)
	local chars = "0123456789abcdef"
	local out = {}
	for i = 1, (len or 12) do
		local idx = math.random(1, #chars)
		out[i] = string.sub(chars, idx, idx)
	end
	return table.concat(out)
end

