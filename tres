		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(0.5, 0)
		rc.Parent = ring
		local rs = Instance.new("UIStroke")
		rs.Thickness = 1.4
		rs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		rs.Parent = ring
		table.insert(strokes, rs)

		local handle = Instance.new("Frame")
		handle.Size = UDim2.fromOffset(7, 2)
		handle.Position = UDim2.fromOffset(12, 13)
		handle.AnchorPoint = Vector2.new(0.5, 0.5)
		handle.Rotation = 45
		handle.BorderSizePixel = 0
		handle.ZIndex = 22
		handle.Parent = box
		local hc = Instance.new("UICorner")
		hc.CornerRadius = UDim.new(0, 2)
		hc.Parent = handle
		table.insert(parts, handle)
	else
		local ys = { 4, 9, 14 }
		local knobXs = { 5, 11, 7 }
		for rowIdx = 1, 3 do
			local rail = Instance.new("Frame")
			rail.Size = UDim2.fromOffset(14, 1)
			rail.Position = UDim2.fromOffset(2, ys[rowIdx])
			rail.BorderSizePixel = 0
			rail.ZIndex = 22
			rail.Parent = box
			table.insert(parts, rail)

