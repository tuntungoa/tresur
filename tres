local function ensureDirs()
	pcall(function()
		if makefolder then
			if not (isfolder and isfolder(Client.Paths.Root)) then makefolder(Client.Paths.Root) end
			if not (isfolder and isfolder(Client.Paths.Configs)) then makefolder(Client.Paths.Configs) end
		end
	end)
end

local function applyDataToState(data)
	if type(data) ~= "table" then return end
	if type(data.width) == "number" then Client.State.width = math.clamp(math.floor(data.width + 0.5), 520, 1650) end
	if type(data.height) == "number" then Client.State.height = math.clamp(math.floor(data.height + 0.5), 340, 960) end
	if type(data.posX) == "number" then Client.State.posX = math.floor(data.posX + 0.5)
	elseif type(data.offsetX) == "number" then Client.State.posX = math.floor(data.offsetX + 0.5) end
	if type(data.posY) == "number" then Client.State.posY = math.floor(data.posY + 0.5)
	elseif type(data.offsetY) == "number" then Client.State.posY = math.floor(data.offsetY + 0.5) end
	if type(data.theme) == "string" and Client.Themes[data.theme] then Client.State.theme = data.theme end
	local validChests = {
		["Common Chest"] = true, ["Uncommon Chest"] = true,
		["Rare Chest"] = true, ["Epic Chest"] = true, ["Legendary Chest"] = true,
	}
	if type(data.chestType) == "string" and validChests[data.chestType] then Client.State.chestType = data.chestType end
	local validPresets = { FarmRaft = true, Heart = true, Tower = true }
	if type(data.buildPreset) == "string" and validPresets[data.buildPreset] then Client.State.buildPreset = data.buildPreset end

	local boolKeys = {
		"muteStartupVoice", "neonBorderGlow",
		"autoFarmGold", "antiAfk", "autoBuyChest",
		"walkOnWater", "flyEnabled", "infJump", "boatFly", "antiRagdoll", "clickTp",
		"espPlayers", "espChams", "chestBeam", "antiDarkness", "fullbright", "hologramPreview",
	}
	for _, k in ipairs(boolKeys) do
		if type(data[k]) == "boolean" then Client.State[k] = data[k] end
	end
	local numBounds = {
		farmStageDelay = { 6, 20 },
		flySpeed = { 20, 160 },
		boatFlySpeed = { 25, 180 },
	}
	for k, lim in pairs(numBounds) do
		if type(data[k]) == "number" then
			Client.State[k] = math.clamp(math.floor(data[k] + 0.5), lim[1], lim[2])
		end
	end
end

function Client.SaveAutoload(cfgName)
	ensureDirs()
	if typeof(writefile) ~= "function" then return end
	pcall(function()
		writefile(Client.Paths.Autoload, HttpService:JSONEncode({
			activeConfig = cfgName or Client.ActiveConfigName,
		}))
	end)
end

function Client.SaveConfig(cfgName)
	local clean = sanitizeConfigName(cfgName or Client.ActiveConfigName)
	if clean == "" then return false, "Only English letters, digits, _ or -" end
	ensureDirs()
	if typeof(writefile) ~= "function" then return false, "writefile unavailable" end
	Client.ActiveConfigName = clean
	local path = Client.Paths.Configs .. "/" .. clean .. ".json"
	local ok = pcall(function()
		writefile(path, HttpService:JSONEncode(Client.State))
		writefile(Client.Paths.LegacyLayout, HttpService:JSONEncode(Client.State))
	end)
	if ok then
		Client.SaveAutoload(clean)
		return true, clean
	end
	return false, "Write failed"
end

function Client.LoadConfig(cfgName)
	local clean = sanitizeConfigName(cfgName)
	if clean == "" then return false, "Invalid name" end
	local path = Client.Paths.Configs .. "/" .. clean .. ".json"
	if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" or not isfile(path) then
		return false, "Config not found"
	end
	local ok, raw = pcall(readfile, path)
	if not ok or not raw or #raw < 2 then return false, "Read error" end
	local okDec, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not okDec or type(data) ~= "table" then return false, "Corrupt JSON" end
	applyDataToState(data)
	Client.ActiveConfigName = clean
	Client.SaveAutoload(clean)
	return true, clean
end

function Client.DeleteConfig(cfgName)
	local clean = sanitizeConfigName(cfgName)
	if clean == "" then return false, "Invalid name" end
	local path = Client.Paths.Configs .. "/" .. clean .. ".json"
	if typeof(isfile) == "function" and typeof(delfile) == "function" and isfile(path) then
		local ok = pcall(delfile, path)
		if ok then
			if Client.ActiveConfigName == clean then Client.ActiveConfigName = "Default" end
			return true
		end
	end
	return false, "Cannot delete"
end

function Client.ListConfigs()
	ensureDirs()
	local names = {}
	if typeof(listfiles) == "function" and (typeof(isfolder) ~= "function" or isfolder(Client.Paths.Configs)) then
		local ok, entries = pcall(listfiles, Client.Paths.Configs)
		if ok and type(entries) == "table" then
			for _, entry in ipairs(entries) do
				local name = tostring(entry):match("([^/\\]+)%.json$")
				if name and sanitizeConfigName(name) == name then
					table.insert(names, name)
				end
			end
		end
	end
	table.sort(names)
	if #names == 0 then
		Client.SaveConfig("Default")
		table.insert(names, "Default")
	end
	return names
end

do
	ensureDirs()
	local bootName = "Default"
	if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(Client.Paths.Autoload) then
		local ok, raw = pcall(readfile, Client.Paths.Autoload)
		if ok and raw then
			local okDec, dec = pcall(function() return HttpService:JSONDecode(raw) end)
			if okDec and type(dec) == "table" and type(dec.activeConfig) == "string" then
				local cleaned = sanitizeConfigName(dec.activeConfig)
				if cleaned ~= "" then bootName = cleaned end
			end
		end
	end
	local loadedOk = Client.LoadConfig(bootName)
	if not loadedOk then
		if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(Client.Paths.LegacyLayout) then
			local ok, raw = pcall(readfile, Client.Paths.LegacyLayout)
			if ok and raw then
				local okDec, dec = pcall(function() return HttpService:JSONDecode(raw) end)
				if okDec and type(dec) == "table" then applyDataToState(dec) end
			end
		end
		Client.SaveConfig("Default")
	end
	Client.ListConfigs()
end

