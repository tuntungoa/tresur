	local function setColor(col, trans)
		for _, p in ipairs(parts) do
			p.BackgroundColor3 = col
			p.BackgroundTransparency = trans or 0
		end
		for _, s in ipairs(strokes) do
			s.Color = col
			s.Transparency = trans or 0
		end
	end
	setColor(initialColor, 0)
	return setColor
end

