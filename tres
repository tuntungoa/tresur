-- 16. INTRO -> LIQUID GLASS TRANSITION
-- ============================================================================
local transitionedToGlass = false
local starsActive = true

local function transitionToLiquidGlass()
	if transitionedToGlass then return end
	transitionedToGlass = true
	starsActive = false

	Client.TrackTween(TweenService:Create(blurEffect, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = 0 }))
	task.delay(0.46, function()
		if Client.Alive and blurEffect then blurEffect.Enabled = false end
	end)

	local fadeSky = TweenInfo.new(0.40, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, m in ipairs(meteors) do Client.TrackTween(TweenService:Create(m.img, fadeSky, { ImageTransparency = 1 })) end
	for _, s in ipairs(stars) do Client.TrackTween(TweenService:Create(s.img, fadeSky, { ImageTransparency = 1 })) end
	task.delay(0.42, function()
		if Client.Alive and skyLayer then skyLayer.Visible = false end
	end)

	Client.TrackTween(TweenService:Create(introPanel, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
		Position = UDim2.new(0.5, 0, 0.48, 0),
		BackgroundTransparency = 1
	}))
	Client.TrackTween(TweenService:Create(introStroke, TweenInfo.new(0.35), { Transparency = 1 }))
	for _, child in ipairs(introPanel:GetDescendants()) do
		if child:IsA("TextLabel") then Client.TrackTween(TweenService:Create(child, TweenInfo.new(0.32), { TextTransparency = 1 }))
		elseif child:IsA("ImageLabel") then Client.TrackTween(TweenService:Create(child, TweenInfo.new(0.32), { ImageTransparency = 1 }))
		elseif child:IsA("Frame") then Client.TrackTween(TweenService:Create(child, TweenInfo.new(0.32), { BackgroundTransparency = 1 })) end
	end

	Client.TrackTween(TweenService:Create(backdrop, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.05
	}))

	task.delay(0.32, function()
		if not Client.Alive then return end
		introPanel.Visible = false

		clampWindowTarget()
		curX, curY, curW, curH = targetX, targetY, targetW, targetH
		glassWindow.Position = UDim2.fromOffset(math.floor(curX + 0.5), math.floor(curY + 0.5))
		glassWindow.Size = UDim2.fromOffset(math.floor(curW * 0.96), math.floor(curH * 0.96))
		glassWindow.BackgroundTransparency = 1
		glassWindow.Visible = true

		if #hatFrontAssets > 0 then
			local initHatPos = UDim2.fromOffset(math.floor(curX + curW + 0.5), math.floor(curY + 0.5))
			hatBackHolder.Position = initHatPos
			hatFrontHolder.Position = initHatPos
			hatBackHolder.Visible = true
			hatFrontHolder.Visible = true
			hatNextIdleAt = os.clock() + 4.0
		end

		local glassIn = TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		Client.TrackTween(TweenService:Create(glassWindow, glassIn, {
			Size = UDim2.fromOffset(math.floor(curW + 0.5), math.floor(curH + 0.5)),
			BackgroundTransparency = 0.44
		}))
		Client.TrackTween(TweenService:Create(glassOuterStroke, glassIn, { Transparency = 0.22 }))
		Client.TrackTween(TweenService:Create(neonRimStroke, glassIn, { Transparency = Client.State.neonBorderGlow and 0.79 or 1 }))
		Client.TrackTween(TweenService:Create(innerChamberStroke, glassIn, { Transparency = 0.62 }))
		Client.TrackTween(TweenService:Create(topMeniscus, glassIn, { BackgroundTransparency = 0.08 }))
		Client.TrackTween(TweenService:Create(botMeniscus, glassIn, { BackgroundTransparency = Client.State.neonBorderGlow and 0.16 or 1 }))
		if liquidSheen then Client.TrackTween(TweenService:Create(liquidSheen, glassIn, { ImageTransparency = 0.24 })) end
		if glassFrostGrain then Client.TrackTween(TweenService:Create(glassFrostGrain, glassIn, { ImageTransparency = 0.56 })) end
	end)
end

-- ============================================================================
-- 16. MAIN RENDER LOOP (UI + INTRO + GLASS + CORNER HAT)
-- ============================================================================
local TOTAL_FRAMES = #sheetLabels * 9
local FRAME_RATE = 16
local activeSheetIdx = 1
local activeHatSheetIdx = 1
local startTime = os.clock()
local animStart = os.clock()
local LOAD_DURATION = 5.2

local statusPhases = {
	{ p = 0.00, text = "Загружаем оформление..." },
	{ p = 0.30, text = "Подготавливаем интерфейс..." },
	{ p = 0.68, text = "Почти готово..." },
	{ p = 0.96, text = "Готово!" },
}

local fpsSamples, fpsAccum, lastPerfReport = 0, 0, os.clock()

Client.Bind(RunService.RenderStepped, function(dt)
	if not Client.Alive then return end
	local now = os.clock()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local th = getTheme()

	-- Telemetry (every 0.5s)
	fpsSamples = fpsSamples + 1
	fpsAccum = fpsAccum + dt
	if (now - lastPerfReport) >= 0.5 and fpsStatusLabel then
		local avgFps = fpsAccum > 0 and math.floor((fpsSamples / fpsAccum) + 0.5) or 0
		local memMb = collectgarbage("count") / 1024
		fpsStatusLabel.Text = string.format("FPS: %d | %.1f MB", avgFps, memMb)
		fpsSamples = 0
		fpsAccum = 0
		lastPerfReport = now
	end

	-- 1) Intro Falling Stars & Meteors
	if starsActive then
		for _, m in ipairs(meteors) do
			m.x = m.x + m.vx * dt
			m.y = m.y + m.vy * dt
			m.img.Position = UDim2.fromOffset(math.floor(m.x), math.floor(m.y))
			m.img.ImageTransparency = math.clamp(m.baseTrans + 0.08 * math.sin(now * 4 + m.phase), 0, 0.8)
			if m.y > vp.Y + 220 or m.x < -260 then
				m.y = math.random(-280, -40)
				m.x = math.random(math.floor(vp.X * 0.15), math.floor(vp.X + 260))
			end
		end
		for _, s in ipairs(stars) do
			s.x = s.x + s.vx * dt + math.sin(now * 1.3 + s.phase) * 10 * dt
			s.y = s.y + s.vy * dt
			local twinkle = 0.5 + 0.5 * math.sin(now * 3.2 + s.phase)
			s.img.ImageTransparency = 0.08 + 0.52 * twinkle
			local curSz = math.floor(s.baseSize * (0.82 + 0.25 * (1 - twinkle)))
			s.img.Size = UDim2.fromOffset(curSz, curSz)
			s.img.Rotation = s.img.Rotation + 14 * dt
			if s.y > vp.Y + 40 then
				s.y = -30
				s.x = math.random(20, math.floor(vp.X - 20))
			end
			s.img.Position = UDim2.fromOffset(math.floor(s.x), math.floor(s.y))
		end
	end

	-- 2) Liquid Glass UI & Corner Hat
	if transitionedToGlass then
		strokeGrad.Rotation = 38 + math.sin(now * 0.8) * 14
		neonRimGrad.Rotation = (now * 24) % 360

		kronosTitleGrad.Offset = Vector2.new(math.sin(now * 1.15) * 0.32, 0)
		local sweep = ((now * 0.68) % 2.2) - 1.1
		subFillGrad.Offset = Vector2.new(sweep, 0)
		subStrokeGrad.Rotation = (now * 48) % 360
		subTextGrad.Offset = Vector2.new(math.sin(now * 1.8) * 0.35, 0)
		if miscSubFillGrad then miscSubFillGrad.Offset = Vector2.new(sweep, 0) end
		if miscSubStrokeGrad then miscSubStrokeGrad.Rotation = (now * 48) % 360 end
		if miscSubTextGrad then miscSubTextGrad.Offset = Vector2.new(math.sin(now * 1.8) * 0.35, 0) end
		if miscSubAura then miscSubAura.ImageTransparency = 0.36 + 0.16 * (0.5 + 0.5 * math.sin(now * 2.8)) end
		if miscSubStar then miscSubStar.Rotation = miscSubStar.Rotation + 36 * dt end
		if subAura then subAura.ImageTransparency = 0.36 + 0.16 * (0.5 + 0.5 * math.sin(now * 2.8)) end
		if sideHeaderGlow then sideHeaderGlow.ImageTransparency = 0.58 + 0.12 * (0.5 + 0.5 * math.cos(now * 1.8)) end
		if subStar then subStar.Rotation = subStar.Rotation + 36 * dt end

		if #hatFrontLabels > 0 and HAT_TOTAL_FRAMES > 0 then
			if not hatAnimStartedAt and hatNextIdleAt and now >= hatNextIdleAt then
				hatAnimStartedAt = now
				hatNextIdleAt = now + 14.0
			end
			local hatFrameIdx0 = 0
			local breezeFps = 14
			local breezeDur = HAT_TOTAL_FRAMES / breezeFps
			if hatAnimStartedAt then
				local el = now - hatAnimStartedAt
				if el < breezeDur then hatFrameIdx0 = math.min(HAT_TOTAL_FRAMES - 1, math.floor(el * breezeFps))
				else hatAnimStartedAt = nil; hatFrameIdx0 = 0 end
			end
			local hSheetIdx = math.floor(hatFrameIdx0 / HAT_PER_SHEET) + 1
			local hLocalIdx = hatFrameIdx0 % HAT_PER_SHEET
			local hCol = hLocalIdx % HAT_COLS
			local hRow = math.floor(hLocalIdx / HAT_COLS)
			local rectOff = Vector2.new(hCol * HAT_CELL_W, hRow * HAT_CELL_H)

			local targetF = hatFrontLabels[hSheetIdx]
			if targetF then
				targetF.ImageRectOffset = rectOff
				if hSheetIdx ~= activeHatSheetIdx then
					if hatFrontLabels[activeHatSheetIdx] then
						hatFrontLabels[activeHatSheetIdx].ImageTransparency = 1
						hatFrontLabels[activeHatSheetIdx].ZIndex = 36
					end
					targetF.ImageTransparency = 0
					targetF.ZIndex = 37
				end
			end
			local targetB = hatBackLabels[hSheetIdx]
			if targetB then
				targetB.ImageRectOffset = rectOff
				if hSheetIdx ~= activeHatSheetIdx then
					if hatBackLabels[activeHatSheetIdx] then
						hatBackLabels[activeHatSheetIdx].ImageTransparency = 1
						hatBackLabels[activeHatSheetIdx].ZIndex = 13
					end
					targetB.ImageTransparency = 0
					targetB.ZIndex = 14
				end
			end
			activeHatSheetIdx = hSheetIdx
			local swayRot = HAT_BASE_ROT + math.sin(now * 1.4) * 0.45
			hatFrontHolder.Rotation = swayRot
			hatBackHolder.Rotation = swayRot
		end

		local lerpAlpha = 1 - math.exp(-dt * 22)
		curX = curX + (targetX - curX) * lerpAlpha
		curY = curY + (targetY - curY) * lerpAlpha
		curW = curW + (targetW - curW) * lerpAlpha
		curH = curH + (targetH - curH) * lerpAlpha

		local rx, ry = math.floor(curX + 0.5), math.floor(curY + 0.5)
		local rw, rh = math.floor(curW + 0.5), math.floor(curH + 0.5)
		glassWindow.Position = UDim2.fromOffset(rx, ry)
		glassWindow.Size = UDim2.fromOffset(rw, rh)
		local hatPos = UDim2.fromOffset(rx + rw, ry)
		hatFrontHolder.Position = hatPos
		hatBackHolder.Position = hatPos
	end

	-- 3) Intro Sprite Sheet & Progress
	if not transitionedToGlass then
		if TOTAL_FRAMES > 0 then
			local frameIdx0 = math.floor((now - animStart) * FRAME_RATE) % TOTAL_FRAMES
			local sheetIdx = math.floor(frameIdx0 / 9) + 1
			local localIdx = frameIdx0 % 9
			local col = localIdx % 3
			local row = math.floor(localIdx / 3)
			local targetImg = sheetLabels[sheetIdx]
			if targetImg then
				targetImg.ImageRectOffset = Vector2.new(col * CELL_W, row * CELL_H)
				if sheetIdx ~= activeSheetIdx then
					if sheetLabels[activeSheetIdx] then
						sheetLabels[activeSheetIdx].ImageTransparency = 1
						sheetLabels[activeSheetIdx].ZIndex = 7
					end
					targetImg.ImageTransparency = 0
					targetImg.ZIndex = 8
					activeSheetIdx = sheetIdx
				end
			end
		end
		if tipStar then tipStar.Rotation = tipStar.Rotation + 65 * dt end
		local elapsed = now - startTime
		local progress = math.clamp(elapsed / LOAD_DURATION, 0, 1)
		fill.Size = UDim2.new(progress, 0, 1, 0)
		percentLabel.Text = string.format("%d%%", math.floor(progress * 100 + 0.5))
		local curText = statusPhases[1].text
		for _, st in ipairs(statusPhases) do
			if progress >= st.p then curText = st.text end
		end
		statusLabel.Text = curText
		if elapsed >= (LOAD_DURATION + 0.3) then transitionToLiquidGlass() end
	end

	-- 4) Golden Chest Beam
	local chestTrg = Engine.getChestTrigger()
	local myChar = localPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	if Engine.chestLine and Engine.chestText then
		if Client.State.chestBeam and chestTrg and cam then
			local p2d, onScr = cam:WorldToViewportPoint(chestTrg.Position)
			if p2d.Z > 0 and onScr then
				local dist = myRoot and math.floor((chestTrg.Position - myRoot.Position).Magnitude + 0.5) or 0
				Engine.chestLine.From = Vector2.new(vp.X * 0.5, vp.Y - 12)
				Engine.chestLine.To = Vector2.new(p2d.X, p2d.Y)
				Engine.chestLine.Color = th.neon
				Engine.chestLine.Visible = true
				Engine.chestText.Position = Vector2.new(p2d.X, p2d.Y - 18)
				Engine.chestText.Text = string.format("TREASURE · %dm", dist)
				Engine.chestText.Color = th.bright
				Engine.chestText.Visible = true
			else
				Engine.chestLine.Visible = false
				Engine.chestText.Visible = false
			end
		else
			Engine.chestLine.Visible = false
			Engine.chestText.Visible = false
		end
	end

	-- 5) Player ESP & Chams (Theme-Synced)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer then
			local ch = plr.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local root = ch and ch:FindFirstChild("HumanoidRootPart")
			local head = ch and ch:FindFirstChild("Head")
			if not ch or not ch:IsDescendantOf(workspace) or not hum or hum.Health <= 0 or not root or not head then
				Engine.clearEspForPlayer(plr)
			else
				if Client.State.espChams then
					local hl = Client.Janitor.highlights[plr]
					if not hl or not hl.Parent then
						hl = Instance.new("Highlight")
						hl.Name = randName(8)
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.FillTransparency = 0.68
						hl.OutlineTransparency = 0.1
						hl.Parent = gethui()
						Client.Janitor.highlights[plr] = hl
					end
					hl.Adornee = ch
					hl.FillColor = th.accent
					hl.OutlineColor = th.bright
					hl.Enabled = true
				elseif Client.Janitor.highlights[plr] then
					Client.Janitor.highlights[plr].Enabled = false
				end

				if Client.State.espPlayers and Engine.hasDrawing and cam then
					local ent = Engine.getOrCreateEsp(plr)
					local top2D, on1 = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
					local bot2D, on2 = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
					local root2D, onR = cam:WorldToViewportPoint(root.Position)
					if (on1 or on2 or onR) and root2D.Z > 0 then
						local boxH = math.max(14, math.abs(bot2D.Y - top2D.Y))
						local boxW = boxH * 0.58
						local bx, by = root2D.X - boxW * 0.5, top2D.Y
						ent.boxOutline.Position = Vector2.new(bx, by)
						ent.boxOutline.Size = Vector2.new(boxW, boxH)
						ent.boxOutline.Visible = true
						ent.boxMain.Position = Vector2.new(bx, by)
						ent.boxMain.Size = Vector2.new(boxW, boxH)
						ent.boxMain.Color = th.neon
						ent.boxMain.Visible = true
						local dist = myRoot and math.floor((root.Position - myRoot.Position).Magnitude + 0.5) or 0
						local tName = plr.Team and plr.Team.Name or "none"
						ent.nameTxt.Position = Vector2.new(root2D.X, by - 16)
						ent.nameTxt.Text = string.format("%s [%s · %dm]", plr.DisplayName, tName, dist)
						ent.nameTxt.Color = th.bright
						ent.nameTxt.Visible = true
					else
						Engine.clearEspForPlayer(plr)
					end
				elseif Engine.espEntries[plr] then
					Engine.clearEspForPlayer(plr)
				end
			end
		end
	end

	-- 6) Anti-Ragdoll guard
	if myChar and myRoot and Client.State.antiRagdoll then
		local myHum = myChar:FindFirstChildOfClass("Humanoid")
		if myHum and myHum.Health > 0 then
			if myHum:GetState() == Enum.HumanoidStateType.Physics or myHum:GetState() == Enum.HumanoidStateType.Ragdoll then
				myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
			if myHum.PlatformStand and not Client.State.flyEnabled and not Client.State.autoFarmGold and not myHum.SeatPart then
				myHum.PlatformStand = false
			end
		end
	end

	-- 7) AFK Auto-Farm Gold (Smooth Y=18 Glide Across All 10 Stages + Golden Chest + Claim)
	if Client.State.autoFarmGold and not Engine.farmBusy and myChar and myRoot then
		Engine.farmBusy = true
		task.spawn(function()
			local farmTw = nil
			pcall(function()
				local ch = localPlayer.Character
				local r = ch and ch:FindFirstChild("HumanoidRootPart")
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				local ns = Engine.getNormalStages()
				if r and h and h.Health > 0 and ns then
					Engine.applyWaterProtection(true)
					local bv = Instance.new("BodyVelocity")
					bv.MaxForce = Vector3.new(9e5, 9e5, 9e5)
					bv.Velocity = Vector3.zero
					bv.Parent = r
					Engine.farmBV = bv
					h.PlatformStand = true

					r.AssemblyLinearVelocity = Vector3.zero
					r.CFrame = CFrame.new(-51.5, 18, 950)

					local totalDur = math.max(10, (Client.State.farmStageDelay or 12) * 1.65)
					farmTw = TweenService:Create(r, TweenInfo.new(totalDur, Enum.EasingStyle.Linear), {
						CFrame = CFrame.new(-51.5, 18, 8600)
					})
					farmTw:Play()

					local twDone = false
					local twConn = farmTw.Completed:Once(function() twDone = true end)
					while not twDone and Client.Alive and Client.State.autoFarmGold and r.Parent and h.Health > 0 do
						r.AssemblyLinearVelocity = Vector3.zero
						task.wait(0.15)
					end
					if twConn then pcall(function() twConn:Disconnect() end) end
					if not twDone and farmTw then pcall(function() farmTw:Cancel() end) end

					if Client.Alive and Client.State.autoFarmGold and r.Parent and h.Health > 0 then
						local trg = Engine.getChestTrigger()
						if trg then
							r.AssemblyLinearVelocity = Vector3.zero
							ch:PivotTo(trg.CFrame + Vector3.new(0, 2, 0))
							Engine.touchTrigger(r, trg)
							task.wait(1.3)
							Engine.claimGold()
						end
					end

					Engine.stopFarmStabilizer()

					local waitStart = os.clock()
					while Client.Alive and Client.State.autoFarmGold and (os.clock() - waitStart) < 12 do
						local curCh = localPlayer.Character
						local curR = curCh and curCh:FindFirstChild("HumanoidRootPart")
						local curH = curCh and curCh:FindFirstChildOfClass("Humanoid")
						if curCh ~= ch and curR and curH and curH.Health > 0 and curR.Position.Z < 900 then
							break
						end
						if curCh == ch and curR and curR.Position.Z < 900 and (os.clock() - waitStart) > 2 then
							Engine.claimGold()
							break
						end
						task.wait(0.35)
					end
					task.wait(0.6)
				end
			end)
			if farmTw then pcall(function() farmTw:Cancel() end) end
			Engine.stopFarmStabilizer()
			Engine.applyWaterProtection(Client.State.walkOnWater)
			Engine.farmBusy = false
		end)
	end

	-- 8) Throttled Gold Telemetry, Target Sync, Water/Darkness & Auto-Chest Buy
	if (now - Engine.lastGoldCheck) >= 0.6 then
		Engine.lastGoldCheck = now
		if Engine.goldStatsLabel and Engine.goldVal then
			local curG = Engine.goldVal.Value
			local gained = math.max(0, curG - Engine.startGold)
			Engine.goldStatsLabel.Text = string.format("Золото: %d | За сессию: +%d", curG, gained)
		end
	end

	if (now - Engine.lastTargetScan) >= 1.5 then
		Engine.lastTargetScan = now
		Engine.refreshTargetLabel(false)
		if Client.State.walkOnWater and Engine.waterDeckParts then
			for _, seg in ipairs(Engine.waterDeckParts) do
				if seg and seg.Parent then seg.Color = th.neon end
			end
		end
		if Client.State.hologramPreview and Engine.hologramFolder then
			for _, gp in ipairs(Engine.hologramFolder:GetChildren()) do
				if gp:IsA("BasePart") then gp.Color = th.neon end
			end
		end
	end

	if (now - Engine.lastEnvSync) >= 0.5 then
		Engine.lastEnvSync = now
		if Client.State.walkOnWater then Engine.applyWaterProtection(true) end
		if Client.State.antiDarkness then Engine.applyAntiDarkness(true) end
	end

	if Client.State.autoBuyChest and (now - Engine.lastShopBuy) >= 1.25 then
		Engine.lastShopBuy = now
		local shopRem = workspace:FindFirstChild("ItemBoughtFromShop")
		if shopRem then
			task.spawn(function()
				pcall(function() shopRem:InvokeServer(Client.State.chestType, 1) end)
			end)
		end
	end

end)

Client.Bind(UserInputService.InputBegan, function(input, gp)
	if not gp and input.KeyCode == Enum.KeyCode.RightShift then
		backdrop.Visible = not backdrop.Visible
		if not transitionedToGlass then
			blurEffect.Enabled = backdrop.Visible
		else
			blurEffect.Enabled = false
		end
	end
end)
